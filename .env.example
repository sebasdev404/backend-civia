# ==========================================
# CIVIA - BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Base de Datos (PostgreSQL local o en la nube)
# Para PostgreSQL local:
DATABASE_URL=postgresql://postgres:1234@localhost:5432/civia_db

# 2. Seguridad y Tokens JWT
ENVIRONMENT=development
# Generate a unique random secret for each deployment; never commit the real value.
SECRET_KEY=generate-your-own-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 3. CORS - Orígenes permitidos (Frontend Next.js)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 4. Integraciones de Inteligencia Artificial (OpenAI)
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai
OPINION_ANALYSIS_MODEL=gpt-4o-mini
# Cola periódica de comentarios con contexto. Activarla consume crédito de IA.
AUTO_ANALYZE_ENABLED=false

# 5. Integración Meta Graph API (Facebook / Instagram)
META_APP_ID=tu_meta_app_id
META_APP_SECRET=tu_meta_app_secret
META_VERIFY_TOKEN=civia_meta_webhook_neiva_2026
META_PAGE_ACCESS_TOKEN=tu_meta_page_access_token
META_PAGE_ID=tu_meta_page_id

# 6. Recuperación por correo: configurar valores reales solo en el .env privado.
# Gmail preparado: completa usuario, contraseña de aplicación y remitente.
# Los campos vacíos mantienen el envío desactivado hasta disponer de la cuenta.
# TLS (STARTTLS, normalmente puerto 587) y SSL (normalmente 465) son excluyentes.
SMTP_HOST=smtp.gmail.com
PUBLIC_APP_URL=http://localhost:3000
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false
