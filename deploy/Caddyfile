{
 email {$ACME_EMAIL}
}
{$CIVIA_DOMAIN} {
 encode zstd gzip
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  X-Frame-Options DENY
  Referrer-Policy strict-origin-when-cross-origin
  -Server
 }
 request_body {
  max_size 12MB
 }
 @webhook path /api/v1/meta/webhook
 handle @webhook {
  reverse_proxy backend:8000
 }
 handle {
  reverse_proxy frontend:3000 {
   header_up X-Civia-Gateway {$CIVIA_PROXY_SECRET}
   header_up X-Civia-Client-IP {remote_host}
  }
 }
}
