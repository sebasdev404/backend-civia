FROM postgres:18
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock ./
RUN python3 -m venv /opt/civia && /opt/civia/bin/pip install --no-cache-dir -r requirements.lock
COPY app ./app
COPY ops ./ops
ENTRYPOINT ["/opt/civia/bin/python","ops/backup.py"]
