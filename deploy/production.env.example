# Copy to production.env privately; never commit real values.
ENVIRONMENT=production
DATABASE_URL=postgresql://civia:REPLACE_URL_ENCODED_PASSWORD@database:5432/civia
SECRET_KEY=generate-a-private-random-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["https://REPLACE_WITH_DOMAIN"]
PUBLIC_ASSET_BASE=/assets
PUBLIC_APP_URL=https://REPLACE_WITH_DOMAIN
AUTO_SYNC_ENABLED=true
AUTO_ANALYZE_ENABLED=false
SESSION_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
OPENAI_API_KEY=
OPINION_ANALYSIS_MODEL=gpt-4o-mini
# Perfil Gmail. Completar las tres credenciales/correo antes de probar entrega.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false
