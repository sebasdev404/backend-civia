# Configuración de Base de Datos (Supabase Transaction pooler o Session pooler)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Seguridad
SECRET_KEY=generar_una_clave_aleatoria_super_segura
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS - Separados por comas si hay varios
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Integraciones de Inteligencia Artificial
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai
